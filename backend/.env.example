# Copie de ../.env.example (source de référence), pour exécuter Laravel hors Docker.
# Hors Docker : DB_HOST=127.0.0.1 et REDIS_HOST=127.0.0.1.
# =============================================================================
# CASHOP — variables d'environnement (exemple)
# Copier en .env et remplir. NE JAMAIS committer de valeurs réelles.
# En production, ces valeurs viennent d'un gestionnaire de secrets (Vault / KMS),
# pas d'un fichier. Détail de chaque variable : docs/ENVIRONMENT.md
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=Cashop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
LOG_CHANNEL=stack
LOG_STACK=json

# ─── Base de données ─────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cashop
DB_USERNAME=cashop
DB_PASSWORD=

# ─── Redis (cache, queue, verrous, rate limiting) ───────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# ─── Front-ends ──────────────────────────────────────────────────────────────
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001
SESSION_DOMAIN=localhost

# ─── Sécurité ────────────────────────────────────────────────────────────────
# Mots de passe et PIN hachés en Argon2id
HASH_DRIVER=argon2id
# Secret HMAC pour les webhooks internes (mocks) et jetons d'URL de callback
WEBHOOK_SIGNING_SECRET=
# Durée de validité des clés d'idempotence (heures)
IDEMPOTENCY_TTL_HOURS=24

# ─── Mode des providers : mock | sandbox | production ───────────────────────
# Tant qu'un provider n'a pas passé les 18 étapes d'intégration, il reste en "mock".
VISA_MODE=mock
MONEYGRAM_MODE=mock
WESTERN_UNION_MODE=mock
MTN_MODE=mock
AIRTEL_MODE=mock

# ─── Visa Direct ─────────────────────────────────────────────────────────────
# Chemins vers des fichiers montés depuis le gestionnaire de secrets (jamais le contenu ici).
VISA_API_KEY=
VISA_USERNAME=
VISA_PASSWORD=
VISA_CERTIFICATE=
VISA_PRIVATE_KEY=
VISA_CA_BUNDLE=
# Message Level Encryption — NOT CONFIRMED : requis ou non selon les API souscrites
VISA_MLE_KEY_ID=
VISA_MLE_SERVER_CERTIFICATE=
VISA_MLE_CLIENT_PRIVATE_KEY=

# ─── MoneyGram ───────────────────────────────────────────────────────────────
MONEYGRAM_CLIENT_ID=
MONEYGRAM_CLIENT_SECRET=
# NOT CONFIRMED — identifiant partenaire fourni à l'onboarding
MONEYGRAM_PARTNER_ID=

# ─── Western Union ───────────────────────────────────────────────────────────
# NOT CONFIRMED — URL, modèle d'auth et certificats fournis par contrat partenaire
WESTERN_UNION_BASE_URL=
WESTERN_UNION_CLIENT_ID=
WESTERN_UNION_CLIENT_SECRET=
WESTERN_UNION_CERTIFICATE=
WESTERN_UNION_PRIVATE_KEY=

# ─── MTN Mobile Money ────────────────────────────────────────────────────────
# Identifiants distincts par pays et par produit : voir config/providers/mtn.php
# (ex. MTN_CM_COLLECTION_SUBSCRIPTION_KEY). Variables génériques demandées :
MTN_CLIENT_ID=
MTN_CLIENT_SECRET=

# ─── Airtel Money ────────────────────────────────────────────────────────────
# Configuration par pays : voir config/providers/airtel.php
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# ─── Services transverses (prestataires à choisir — NOT CONFIRMED) ─────────
FX_RATES_PROVIDER=manual
KYC_VENDOR=manual
SANCTIONS_SCREENING_VENDOR=none
SMS_PROVIDER=log
SENTRY_LARAVEL_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
